{
  "version": 2,
  "theme": "builtin://terminal",
  "editor": {
    "show_menu_bar": false,
    "show_tab_bar": false,
    "show_vertical_scrollbar": false,
    "restore_previous_session": false,
    "animations": true,
    "cursor_jump_animation": false,
    "status_bar": {
      "left": [
        "{fresh_pretty_vim:mode}"
      ],
      "right": [
        "{fresh_pretty_vim:progress}"
      ],
      "separator": " "
    }
  },
  "lsp": {
    "markdown": {
      "enabled": true,
      "auto_start": true,
      "process_limits": {
        "max_memory_percent": 50,
        "max_cpu_percent": 90,
        "enabled": true
      }
    }
  },
  "languages": {
    "markdown": {
      "page_view": true,
      "page_width": 100,
      "line_wrap": true
    }
  },
  "plugins": {
    "pretty_status": {
      "enabled": false
    },
    "vi_visual_arrows": {
      "enabled": false
    },
    "vi_mode": {
      "enabled": true,
      "settings": {
        "autoStart": true
      }
    },
    "vi_mode_custom": {
      "enabled": false
    },
    "fresh_pretty_vim": {
      "enabled": true
    }
  }
}
